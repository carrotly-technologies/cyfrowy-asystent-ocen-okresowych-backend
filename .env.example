# Port the API listens on
PORT=3000
# Origin allowed by CORS (the Vite dev server by default)
FRONTEND_URL=http://localhost:5173
# Fixed "today" of the demo; every deadline is computed against it
DEMO_TODAY=2026-11-21
# Optional PostgreSQL. Unset = in-memory storage (data lost on restart).
# Migrations run automatically at startup. Local DB: `docker compose up -d db`
# DATABASE_URL=postgres://hacknation:hacknation@localhost:5432/hacknation
# AI assistant chat on/off (true/false, default true). With false the frontend
# hides the chat and every /api/assistant/* route returns 404. Restart to apply.
FEATURE_ASSISTANT=true
# HS256 key for sign-in tokens, 32+ bytes (openssl rand -base64 32). Without it a
# dev-only default is used and a warning is logged: always set it in production.
# JWT_SECRET=
# Optional AI assistant LLM: any free OpenAI-compatible chat endpoint.
# Without these the assistant answers extractively (quotes + citations).
# Local Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  (no key)
# Groq free tier: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# Office (urząd) printed on sheets A/B/C: name, city at the signatures, optional
# logo URL shown on the screen sheet, addressee of the objection on sheet A
# (załącznik nr 2 leaves „sprzeciw do: …” blank). Defaults: demo office, Warszawa.
# OFFICE_NAME=Urząd Wojewódzki w Lublinie
# OFFICE_CITY=Lublin
# OFFICE_LOGO_URL=
# OBJECTION_RECIPIENT_A=

# ---- docker compose (docker-compose.yml: db + backend + frontend [+ ollama]) ----
# Password of the bundled PostgreSQL (change it before the first start).
# POSTGRES_PASSWORD=hacknation
# Published ports and the API address the browsers use (baked into the frontend build).
# FRONTEND_PORT=8080
# BACKEND_PORT=3000
# DB_PORT=5432
# PUBLIC_API_URL=http://localhost:3000
# Path of the frontend repository (cloned next to this one by default).
# FRONTEND_DIR=../cyfrowy-asystent-ocen-okresowych-frontend
